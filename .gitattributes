# Normalise line endings so Windows contributors do not produce noisy diffs.
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf

# Generated files: collapse in diffs and exclude from language statistics.
package-lock.json linguist-generated=true -diff
packages/database/migrations/** linguist-generated=true

# Binary assets.
*.png binary
*.jpg binary
*.woff2 binary
*.glb binary
