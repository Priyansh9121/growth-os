{
  "name": "@growth-os/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migrations, tenant-scoped transaction helpers and development seed data.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@growth-os/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
