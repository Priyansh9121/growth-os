# =============================================================================
# Growth OS — repository ignore rules
# =============================================================================
# Every rule here is justified in docs/engineering/gitignore-rationale.md.
#
# RULE FOR CONTRIBUTORS
# ---------------------
# Patterns are ANCHORED (leading `/`) or SCOPED (containing `/`) wherever the
# name could plausibly collide with first-party application code.
#
# An unanchored pattern such as `models/` matches at EVERY depth and would
# silently swallow `packages/database/src/models/`. Anchored `/models/` matches
# only the repository root. When in doubt, anchor.
#
# After editing this file run:
#     npm run verify:gitignore
# which fails if any tracked or first-party source path becomes ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies — reconstructible from package-lock.json, never edited by hand
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/cache/
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# Build output — generated, reconstructible, machine-specific paths inside
# -----------------------------------------------------------------------------
# `.next/` is scoped by name and cannot collide with source (leading dot).
.next/
# ANCHORED. `out/` is the Next.js static-export directory at the repo root.
# Unanchored, it would swallow a future `packages/integrations/src/out/`
# (outbound webhooks). Also caught by scripts/verify-gitignore.mjs.
/out/
# `/dist/` and `/build/` are intentionally NOT used unanchored: a future
# `packages/ui/src/build/` helper directory must not disappear. Scope per app.
apps/*/dist/
apps/*/build/
packages/*/dist/
packages/*/build/
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Environment & secrets — MUST NEVER BE COMMITTED
# -----------------------------------------------------------------------------
# Deny-all then re-allow the documented template. `.env.example` contains only
# placeholders and IS tracked.
.env
.env.*
!.env.example
!.env.*.example

# Credential material of any kind, at any depth.
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets.json
service-account*.json
gha-creds-*.json

# -----------------------------------------------------------------------------
# Test, coverage & profiling artefacts — regenerated by `npm test`
# -----------------------------------------------------------------------------
# ANCHORED. Unanchored `coverage/` would swallow a future
# `packages/seo/src/coverage/` — keyword coverage is a real planned feature.
# Caught by scripts/verify-gitignore.mjs before it could hide anything.
/coverage/
apps/*/coverage/
packages/*/coverage/
.nyc_output/
/playwright-report/
/blob-report/
/test-results/
.playwright/
/lighthouse/
*.cpuprofile
*.heapsnapshot

# -----------------------------------------------------------------------------
# Local database state — may contain seeded PII-shaped data; never shared
# -----------------------------------------------------------------------------
# Anchored: `/pgdata/` at the root only. `packages/database/src/data/` is safe.
/pgdata/
/.dev-db/
*.sqlite
*.sqlite3
*.db-journal
# Database dumps can contain real customer data. Refuse them everywhere.
*.dump
*.sql.gz
/dumps/

# -----------------------------------------------------------------------------
# Logs — routinely contain tokens, session IDs and request bodies
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/logs/

# -----------------------------------------------------------------------------
# Caches — machine-specific, reconstructible
# -----------------------------------------------------------------------------
.cache/
.turbo/
.eslintcache
.stylelintcache
.vitest/
.swc/

# -----------------------------------------------------------------------------
# Large binary assets that do not belong in git history
# -----------------------------------------------------------------------------
# AI model weights. Anchored + extension-scoped so that a future
# `packages/ai/src/models/` (TypeScript model definitions) is NOT ignored.
/model-weights/
*.gguf
*.safetensors
*.onnx
*.ckpt

# Debug captures produced during development
/screenshots/
/.debug/

# -----------------------------------------------------------------------------
# Editor & OS metadata — machine-specific
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

.idea/
*.iml
*.swp
*.swo
*~

# VS Code: ignore personal state, keep shared workspace configuration tracked.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# -----------------------------------------------------------------------------
# Tooling scratch space
# -----------------------------------------------------------------------------
/tmp/
/.scratch/

# -----------------------------------------------------------------------------
# Customer data that must never be committed (Stage 2.5)
# -----------------------------------------------------------------------------
# CSV import means real contact lists now pass through developers' machines. A
# customer's export saved next to the code and committed by a wildcard `git add`
# is a data breach with a git history.
#
# ⚠️ DELIBERATELY NOT `*.csv`.
#
# Test fixtures are legitimately CSV and MUST stay trackable — a rule that hid
# every CSV would silently stop `tests/fixtures/contacts.csv` from being
# committed, and the person who wrote it would not find out until CI failed
# somewhere unrelated. So the rule is scoped to where a real export actually
# lands: a directory named for it, and the obvious ad-hoc filenames.
/customer-data/
/imports/
*.export.csv
*.contacts.csv
*.customers.csv

# Database dumps, wherever they are written.
*.dump
*.sql.gz
/dumps/
