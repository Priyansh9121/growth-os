{
  "name": "growth-os",
  "version": "0.1.0",
  "private": true,
  "description": "Growth OS — an AI growth operating system connecting SEO, CRM, AI agents, voice and revenue attribution into one loop.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @growth-os/web",
    "build": "npm run build:public-scripts && npm run build --workspace @growth-os/web",
    "start": "npm run start --workspace @growth-os/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "npm run db:generate --workspace @growth-os/database",
    "db:migrate": "npm run db:migrate --workspace @growth-os/database",
    "db:seed": "npm run db:seed --workspace @growth-os/database",
    "db:reset": "npm run db:reset --workspace @growth-os/database",
    "db:studio": "npm run db:studio --workspace @growth-os/database",
    "verify:gitignore": "node scripts/verify-gitignore.mjs",
    "verify:all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verify:boundaries && npm run verify:gitignore",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "e2e:ui": "playwright test --ui",
    "verify:bundle": "node scripts/check-bundle-budget.mjs",
    "build:public-scripts": "node scripts/build-public-scripts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
