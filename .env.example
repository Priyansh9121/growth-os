# =============================================================================
# Growth OS — environment template
# =============================================================================
# Copy to `.env.local` (git-ignored) and fill in local values:
#
#     cp .env.example .env.local
#
# NEVER put real credentials in this file. It is tracked in git.
# Every variable is validated at process start by packages/contracts/src/env.ts
# — the application refuses to boot on an invalid or missing required value,
# rather than failing later with an obscure runtime error.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Canonical, externally reachable origin of the web app. Used for:
#   - absolute URLs in emails and OAuth callbacks
#   - the CSRF same-origin check on state-changing requests
#   - deciding whether session cookies get the `Secure` attribute
# Must include scheme, must NOT include a trailing slash.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for the application role.
#
# The application role should NOT be a superuser or the table owner in any
# non-local environment: PostgreSQL exempts superusers and table owners from
# row-level security, which would silently disable our tenant-isolation
# backstop. See docs/security/tenant-isolation.md.
#
# Local development (see docs/operations/local-development.md):
DATABASE_URL=postgresql://growth_os:growth_os@127.0.0.1:5432/growth_os

# Separate database used by integration tests. Tests TRUNCATE tables between
# runs, so this must never point at a database you care about.
# When unset, integration tests are skipped rather than run against DATABASE_URL.
TEST_DATABASE_URL=postgresql://growth_os:growth_os@127.0.0.1:5432/growth_os_test

# Maximum pooled connections held by a single application process.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Sessions & authentication (required)
# -----------------------------------------------------------------------------
# 32+ byte secret, base64. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Currently used to derive the keyed hash of session tokens at rest, so that a
# read-only database leak alone does not yield usable session tokens.
# Rotating this value invalidates every active session — that is intentional.
SESSION_SECRET=replace-me-with-32-bytes-of-base64-entropy

# Sliding session lifetime in seconds (default 30 days). A session is refreshed
# on use up to SESSION_ABSOLUTE_TTL, after which re-authentication is required.
SESSION_IDLE_TTL=2592000
# Hard ceiling in seconds regardless of activity (default 90 days).
SESSION_ABSOLUTE_TTL=7776000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# memory | redis   (redis is not implemented yet — see ADR-0009)
RATE_LIMIT_DRIVER=memory
# Failed sign-in attempts allowed per identifier within the window.
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Content Security Policy
# -----------------------------------------------------------------------------
# Set to `true` to send Content-Security-Policy-Report-Only instead of the
# enforcing header. Intended for a short staging soak when changing the policy.
#
# Defaults to enforcing. A report-only policy left on indefinitely is the most
# common way a CSP project quietly ends up protecting nothing.
# CSP_REPORT_ONLY=false

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
# `json` for machine ingestion, `pretty` for local terminals.
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# Seed data (development only)
# -----------------------------------------------------------------------------
# Password assigned to every seeded demo account by `npm run db:seed`.
# The seed script REFUSES to run when NODE_ENV=production.
# Never reuse a password you use anywhere else.
SEED_PASSWORD=DevOnly!Growth0S

# =============================================================================
# NOT YET IMPLEMENTED — documented so that the integration surface is visible.
# Adding a key here does not enable a feature; see docs/product/product-roadmap.md.
# =============================================================================
# Voice service boundary (Stage 13). Growth OS never talks to telephony
# providers directly; it calls the Python realtime voice service over this URL.
# VOICE_SERVICE_URL=
# VOICE_SERVICE_SIGNING_SECRET=
#
# LLM provider for Growth AI agents (Stage 7). No model is wired up yet; the
# Ask Growth AI panel runs in an explicitly labelled offline demo mode.
# ANTHROPIC_API_KEY=
#
# Google integrations (Stages 5 and 9).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Background jobs (Stage 3).
# REDIS_URL=
